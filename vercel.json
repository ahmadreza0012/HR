{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/payroll/:path*", "destination": "/api/index?path=payroll/:path*" },
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" }
  ]
}
