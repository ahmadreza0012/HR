{
  "buildCommand": "rm -rf .vinext .next dist && npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist/client",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    {
      "source": "/api/:first/:rest*",
      "destination": "/api/employees?path=:first/:rest*"
    }
  ]
}
