# Local development defaults
DATABASE_URL=postgres://kara:kara@localhost:5432/kara_payroll
API_PORT=3001
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Set this in Vercel before building the frontend, using the public API URL.
# Browser-facing API. In Vercel production use the same-origin proxy.
VITE_API_URL=/api
# Vercel server-only secret: deployed Google Apps Script Web App URL.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# Optional Google Apps Script property, not a Vercel variable: a Google Drive
# folder ID used by a future file-retention worker for issued report PDFs.
# REPORTS_FOLDER_ID=...
